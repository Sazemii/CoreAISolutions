<odoo>

    <record id="kanban_timecard_group" model="ir.ui.view">
        <field name="name">kanban_timecard_group</field>
        <field name="model">ez.time.card.group</field>
        <field name="arch" type="xml">
            <kanban 
                action="action_view_timecards" 
                type="object"
                highlight_color="color"
            >
                <field name="id"/>
                <field name="company_id"/>
                <field name="name"/>
                <field name="date1"/>
                <field name="date2"/>
                <field name="count"/>
                <field name="color"/>
                <field name="multi_company"/>                
                <templates>
                    <t t-name="card" class="flex-row">
                        <main class="o_project_kanban_main oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div>
                                    <div t-if="multi_company" class="ms-3">
                                        <i class="fa fa-building me-2" title="Company"/>
                                        <field name="company_id"/>
                                    </div>
                                    <div class="o_text_overflow ms-3">
                                        <i class="fa fa-clock-o me-2" title="Dates"/>
                                        <field name="date1"/>
                                        <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow"/>
                                        <field name="date2"/>
                                    </div>
                                    <div class="ms-3">
                                        <i class="fa fa-fw me-2 fa-address-card text-primary" title="Count"/>
                                        <field name="count"/>
                                        <span> time card<t t-if="record.count.raw_value>1">s</t></span>
                                    </div>
                                    <div class="ms-3">
                                        <field name="states" widget="html"/>
                                    </div>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="tree_timecard_group" model="ir.ui.view">
        <field name="name">tree_timecard_group</field>
        <field name="model">ez.time.card.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="name"/>
                <field name="date1"/>
                <field name="date2"/>
                <field name="count"/>
            </list>
        </field>
    </record>

    <record id="open_timecard_group" model="ir.actions.act_window">
        <field name="name">Time Card Groups</field>
        <field name="res_model">ez.time.card.group</field>
        <field name="view_mode">kanban</field>
    </record>

    <menuitem id="menu_timecard_group"
        action="open_timecard_group"
        parent="ez_timekeeping.menu_timecard"
        sequence="1"
    />

</odoo>