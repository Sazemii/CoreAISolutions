<odoo>

    <template
        id="portal_layout_tkrequest"
        name="Portal layout: Request menu entry"
        inherit_id="portal.portal_breadcrumbs"
        priority="40"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <t t-if="page_name == 'tkrequest' or tkrequest">
                <t t-set="menu_desc" t-value="approve and 'Approve Requests' or 'Requests'"/>
                <li t-attf-class="breadcrumb-item #{'active ' if not tkrequest else ''}">
                    <a t-if="tkrequest" t-attf-href="/my/tkrequest/{{ approve and 1 or 0 }}?{{ keep_query() }}">
                        <t t-esc="menu_desc"/>
                    </a>
                    <t t-else="" t-esc="menu_desc"/>
                </li>
                <li t-if="tkrequest" class="breadcrumb-item active text-truncate">
                    <span t-if="tkrequest.name" t-field="tkrequest.name"/>
                </li>
            </t>
        </xpath>
    </template>

    <!-- Main Menu -->
    <template 
        id="portal_my_home_tkrequest" 
        name="Portal My Home : Request" 
        inherit_id="portal.portal_my_home"
        priority="35"
        customize_show="True"
    >
        <div id="portal_common_category" position="before">
            <div class="o_portal_category row g-2 mt-3" id="portal_ess_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/project/static/src/img/tasks.svg'"/>
                    <t t-set="title">Your Requests</t>
                    <t t-set="text">Create, list and view all of your Requests</t>
                    <t t-set="url" t-value="'/my/tkrequests/0'" />
                    <t t-set="placeholder_count" t-value="'tkrequest_count'" />
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/project/static/src/img/tasks.svg'"/>
                    <t t-set="title">Approve Requests</t>
                    <t t-set="text">Approve, review, and manage all Requests awaiting your approval</t>
                    <t t-set="url" t-value="'/my/tkrequests/1'" />
                    <t t-set="placeholder_count" t-value="'tkrequest_approve_count'" />
                </t>
            </div>
        </div>
    </template>

