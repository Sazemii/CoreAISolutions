    <template id="portal_my_tkrequest" name="My Time Off">
      <t t-call="portal.portal_layout">

        <!-- <t t-call-assets="ez_payroll_ess.tkrequest_assets"/> -->
        <!-- <script type="text/javascript" src="/ez_payroll_ess/static/src/js/utils.js"></script>
        <script type="text/javascript" src="/ez_payroll_ess/static/src/js/portal_tkrequest.js"></script> -->

        <t t-set="breadcrumbs_searchbar" t-value="True"/>
        <!-- <t t-call="ez_payroll_ess.portal_my_tkrequest_modal"/> -->
        <t t-call="portal.portal_searchbar">
            <t t-set="title">Timekeeping Request</t>
        </t>
        <t t-if="not records">
            <p class="alert alert-warning">There are currently no records in your account.</p>
        </t>

        <t t-if="records">
            <div class="row">
                <t t-set="props" t-value="{
                    'employee_id': employee_id,
                    'records': records2,
                    'selections': selections,
                    'lookups': lookups,
                    'approve': approve,
                }"/>
                <owl-component name="ez_payroll_ess.TimekeepingPortaltWidget" 
                    t-att-props="json.dumps(props)"
                />
                <!-- <t t-foreach="records" t-as="rec">
                    <div class="col-md-4">
                        <t t-call="ez_payroll_ess.portal_my_tkrequest_card"/>
                    </div>
                </t> -->
            </div>
            <div t-if="pager" class="o_portal_pager d-flex justify-content-center my-3">
                <t t-call="portal.pager"/>
            </div>
        </t>
      </t>
    </template>

