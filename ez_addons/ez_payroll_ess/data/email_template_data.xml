<odoo>
    <data noupdate="0">
        <!--Email template -->
        <record id="ess_email_template" model="mail.template">
            <field name="name">Employee ESS MFA Email</field>
            <field name="model_id" ref="model_hr_employee" />
            <field name="email_from">{{object.company_id.partner_id.email}}</field>
            <field
                name="email_cc"
            >{{ object.work_email }},</field>
            <field
                name="subject"
            >ESS Login Authentication</field>
            <field name="auto_delete" eval="False" />
            <field name="lang">{{object.company_id.partner_id.lang}}</field>
            <field name="body_html" type="html">
                <p>Hello <t t-out="object.name">John Doe</t>,</p>
                <p>The ESS MFA code is <t t-out="object.mfa_code">0000</t>. Avoid sharing this to anybody.</p>
            </field>
        </record>
    </data>
</odoo>
