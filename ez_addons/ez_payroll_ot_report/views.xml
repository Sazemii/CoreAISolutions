<odoo>

  <record id="pivot_ot_report" model="ir.ui.view">
    <field name="name">pivot_ot_report</field>
    <field name="model">hr.ph.pay.ot.report</field>
    <field name="arch" type="xml">
        <pivot>
          <field name="employee_id" string="Employee" type="row"/>
          <field name="name" string="Compensation"  type="col"/>
          <field name="amount" type="measure"/>
          <field name="time_hrs" type="measure"/>
          <!-- <field name="unit" type="measure"/> -->
        </pivot>
    </field>
  </record>

  <record id="search_ot_report" model="ir.ui.view">
    <field name="name">search_ot_report</field>
    <field name="model">hr.ph.pay.ot.report</field>
    <field name="arch" type="xml">
        <search>
          <field name="year_month"/>
          <field name="employee_id"/>
          <field name="name"/>
          <field name="amount"/>
          <field name="payroll_id"/>
          <field name="date_to"/>

          <separator/>
          <filter name="filter_date" date="date_to" default_period="month" string="Period"/>
          <separator/>

          <filter string="This Month" name="this_month"
            domain="[('year_month','=',context_today().strftime('%Y-%m'))]" />
          <filter string="Last Month" name="last_month"
            domain="[('year_month','=',(context_today() - relativedelta(months=1)).strftime('%Y-%m'))]" />
        </search>
    </field>
  </record>

  <record id="action_ot_report" model="ir.actions.act_window">
    <field name="name">Overtime Report</field>
    <field name="res_model">hr.ph.pay.ot.report</field>
    <field name="view_mode">pivot</field>
    <field name="domain">
      [
        '|',
        ('name','ilike','Overtime'),
        '|',
        ('name','ilike','Holiday'),
        '|',
        ('name','ilike','Restday'),
        '|',
        ('name','ilike','RD'),
        '|',
        ('name','ilike','SH'),
        '|',
        ('name','ilike','Sunday Work'),
        '|',
        ('name','ilike','Sun. Work'),
        '|',
        ('name','ilike','RH'),
        ('name','ilike','night'),
      ]
    </field>
    <field name="context">{'search_default_filter_date': True}</field>
    <field name="view_id" ref="ez_payroll_ot_report.pivot_ot_report"/>
  </record>

  <menuitem
    id="menu_ot_report"
    name="Overtime Report"
    action="action_ot_report"
    parent="ez_payroll.menu_compensation" sequence="64" />

</odoo>