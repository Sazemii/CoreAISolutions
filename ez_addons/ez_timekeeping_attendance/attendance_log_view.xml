<odoo>

    <record id="form_attendance_import_wizard" model="ir.ui.view">
        <field name="name">form_attendance_import_wizard</field>
        <field name="model">ez.attendance.log.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="xls_filename" invisible="1" />
                        <field name="xls_file" filename="xls_filename" />
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </group>

                <footer>
                    <button string="Import XLSX Logs" name="action_xls_import"
                        confirm="Are you sure to continue?"
                        type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="open_attendance_import_wizard" model="ir.actions.act_window">
        <field name="name">Biometrics Import</field>
        <field name="res_model">ez.attendance.log.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

            <!-- groups="hr_attendance.group_hr_attendance_manager"  -->

    <menuitem 
        id="menu_attendance_import_wizard" 
        name="Biometrics Import" 
        parent="hr_attendance.menu_hr_attendance_root" 
        sequence="12" 
        action="open_attendance_import_wizard"
    />

</odoo>