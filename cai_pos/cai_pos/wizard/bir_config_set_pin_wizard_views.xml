<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bir_config_set_pin_wizard_form" model="ir.ui.view">
        <field name="name">bir.config.set.pin.wizard.form</field>
        <field name="model">bir.config.set.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Manager PIN">
                <group>
                    <field name="config_id" invisible="1"/>
                    <field name="new_pin" password="True" placeholder="Enter 4-6 digit PIN"/>
                    <field name="confirm_pin" password="True" placeholder="Confirm PIN"/>
                </group>
                <footer>
                    <button name="action_set_pin" string="Set PIN" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>


