<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Green discount banner removed per user request -->
    <!-- BIR discount information is visible in the receipt only -->
    
    <t t-name="cai_pos.OrderWidget" t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">
        <!-- Hide the "Taxes" row from the order widget (cashier's view) -->
        <!-- BIR-compliant receipts show VAT breakdown in a different format -->
        <xpath expr="//div[hasclass('tax-info')]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>
</templates>
