<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Extend OrderWidget to show BIR discount calculations -->
    <t t-name="point_of_sale.OrderWidget" t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-summary')]" position="before">
            <!-- BIR Discount Summary Banner -->
            <div t-if="hasBIRDiscount and birDiscountInfo" 
                 class="bir-discount-summary d-flex flex-column gap-1 px-3 py-2 border-top"
                 style="background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); border-left: 4px solid #4caf50;">
                
                <!-- Discount Type Header -->
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold" style="color: #2e7d32; font-size: 0.9rem;">
                        <i class="fa fa-tag me-1"/>
                        <t t-esc="birDiscountInfo.name"/>
                    </span>
                    <span t-if="birDiscountInfo.idNumber" 
                          class="badge" 
                          style="background-color: #4caf50; font-size: 0.7rem;">
                        ID: <t t-esc="birDiscountInfo.idNumber"/>
                    </span>
                </div>
                
                <!-- BIR Calculation Breakdown (for VAT-Exempt discounts) -->
                <t t-if="birDiscountInfo.isVatExempt">
                    <div class="bir-calculation text-muted" style="font-size: 0.75rem; line-height: 1.4;">
                        <div class="d-flex justify-content-between">
                            <span>Gross Sales:</span>
                            <span t-esc="formatMonetary(birDiscountInfo.grossSales, {currencyId: props.taxTotals?.currency_id})"/>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Less VAT (÷1.12):</span>
                            <span t-esc="formatMonetary(vatExemptSales, {currencyId: props.taxTotals?.currency_id})"/>
                        </div>
                        <div class="d-flex justify-content-between" style="color: #d32f2f;">
                            <span>Less <t t-esc="birDiscountInfo.percent"/>% Discount:</span>
                            <span>-<t t-esc="formatMonetary(calculatedDiscount, {currencyId: props.taxTotals?.currency_id})"/></span>
                        </div>
                    </div>
                </t>
                
                <!-- Regular discount (non-VAT-exempt) -->
                <t t-else="">
                    <div class="bir-calculation text-muted" style="font-size: 0.75rem; line-height: 1.4;">
                        <div class="d-flex justify-content-between">
                            <span>Subtotal:</span>
                            <span t-esc="formatMonetary(birDiscountInfo.grossSales, {currencyId: props.taxTotals?.currency_id})"/>
                        </div>
                        <div class="d-flex justify-content-between" style="color: #d32f2f;">
                            <span>Less <t t-esc="birDiscountInfo.percent"/>% Discount:</span>
                            <span>-<t t-esc="formatMonetary(calculatedDiscount, {currencyId: props.taxTotals?.currency_id})"/></span>
                        </div>
                    </div>
                </t>
                
            </div>
        </xpath>
    </t>

</templates>

