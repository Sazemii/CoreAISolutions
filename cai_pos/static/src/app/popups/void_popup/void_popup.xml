<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- VoidOrderPopup Template - With Manager PIN Verification -->
    <t t-name="cai_pos.VoidOrderPopup">
        <Dialog title="dialogTitle" size="'md'">
            <div class="void-popup-content">
                
                <!-- ========== STEP 1: PIN Verification ========== -->
                <t t-if="state.step === 'pin'">
                    <!-- Lock Icon Header -->
                    <div class="text-center mb-4">
                        <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #6c757d 0%, #495057 100%); border-radius: 50%; margin: 0 auto 15px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
                            <i class="fa fa-lock" style="font-size: 2em; color: white;"/>
                        </div>
                        <h5 class="mb-2">Manager Authorization Required</h5>
                        <p class="text-muted small mb-0">
                            Enter the Manager PIN to proceed with voiding this order.
                        </p>
                    </div>
                    
                    <!-- Order Info -->
                    <div class="alert alert-secondary mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Order:</strong> <t t-esc="order.name or order.pos_reference"/>
                            </div>
                            <div>
                                <strong>Amount:</strong> 
                                <span class="text-danger fw-bold">
                                    <t t-esc="pos.env.utils.formatCurrency(order.amount_total)"/>
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- PIN Error Message -->
                    <t t-if="state.pinError">
                        <div class="alert alert-danger py-2">
                            <i class="fa fa-times-circle me-2"/>
                            <span t-esc="state.pinError"/>
                        </div>
                    </t>
                    
                    <!-- PIN Input -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="fa fa-key me-1"/>
                            Manager PIN
                        </label>
                        <input 
                            type="password" 
                            class="form-control form-control-lg text-center"
                            style="font-size: 1.5em; letter-spacing: 0.5em; font-weight: bold;"
                            maxlength="6"
                            placeholder="••••••"
                            t-att-value="state.managerPin"
                            t-on-input="onPinInput"
                            t-att-disabled="state.isProcessing"
                            autofocus="autofocus"/>
                        <div class="form-text text-center">
                            Enter 4-6 digit PIN
                        </div>
                    </div>
                </t>
                
                <!-- ========== STEP 2: Void Form ========== -->
                <t t-if="state.step === 'form'">
                    <!-- Verified Badge (if PIN was verified) -->
                    <t t-if="requireManagerAuth and state.pinVerified">
                        <div class="alert alert-success py-2 mb-3">
                            <i class="fa fa-check-circle me-2"/>
                            Manager authorized
                        </div>
                    </t>
                    
                    <!-- Order Info Header -->
                    <div class="alert alert-info mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Order:</strong> <t t-esc="order.name or order.pos_reference"/>
                            </div>
                            <div>
                                <strong>Amount:</strong> 
                                <t t-esc="pos.env.utils.formatCurrency(order.amount_total)"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Error Message -->
                    <t t-if="state.errorMessage">
                        <div class="alert alert-danger">
                            <i class="fa fa-times-circle me-2"/>
                            <span t-esc="state.errorMessage"/>
                        </div>
                    </t>
                    
                    <!-- Void Form -->
                    <div>
                        <!-- Reason Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Void Reason <span class="text-danger">*</span>
                            </label>
                            <select 
                                class="form-select" 
                                t-on-change="onReasonChange"
                                t-att-disabled="state.isProcessing">
                                <option value="">-- Select Reason --</option>
                                <t t-foreach="voidReasons" t-as="reason" t-key="reason.value">
                                    <option 
                                        t-att-value="reason.value"
                                        t-att-selected="state.voidReason === reason.value">
                                        <t t-esc="reason.label"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        
                        <!-- Detailed Explanation -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Details <span class="text-danger">*</span>
                            </label>
                            <textarea 
                                class="form-control" 
                                rows="2"
                                t-att-value="state.voidReasonDetails"
                                t-on-input="onDetailsChange"
                                t-att-disabled="state.isProcessing"
                                placeholder="Enter reason details..."/>
                        </div>
                    </div>
                </t>
                
            </div>
            
            <!-- Footer Buttons -->
            <t t-set-slot="footer">
                <div class="d-flex justify-content-between w-100">
                    <button 
                        class="btn btn-secondary" 
                        t-on-click="cancel"
                        t-att-disabled="state.isProcessing">
                        Cancel
                    </button>
                    
                    <!-- PIN Step: Verify Button -->
                    <t t-if="state.step === 'pin'">
                        <button 
                            class="btn btn-primary" 
                            t-on-click="verifyPin"
                            t-att-disabled="state.isProcessing or state.managerPin.length &lt; 4">
                            <t t-if="state.isProcessing">
                                <i class="fa fa-spinner fa-spin me-1"/>
                                Verifying...
                            </t>
                            <t t-else="">
                                <i class="fa fa-unlock me-1"/>
                                Verify PIN
                            </t>
                        </button>
                    </t>
                    
                    <!-- Form Step: Void Button -->
                    <t t-if="state.step === 'form'">
                        <button 
                            class="btn btn-danger" 
                            t-on-click="confirmVoid"
                            t-att-disabled="state.isProcessing or !state.voidReason or !state.voidReasonDetails">
                            <t t-if="state.isProcessing">
                                <i class="fa fa-spinner fa-spin me-1"/>
                                Processing...
                            </t>
                            <t t-else="">
                                <i class="fa fa-ban me-1"/>
                                Void Order
                            </t>
                        </button>
                    </t>
                </div>
            </t>
        </Dialog>
    </t>

</templates>
