<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================== -->
    <!-- VAT-Inclusive Pricing Helper (Philippine Standard) -->
    <!-- ================================================== -->
    
    <!-- Add VAT-Inclusive Pricing checkbox and price field BEFORE Sales Price -->
    <record id="product_template_form_view_inherit_vat_inclusive" model="ir.ui.view">
        <field name="name">product.template.form.inherit.vat.inclusive</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <!-- Add checkbox BEFORE Sales Price label -->
            <xpath expr="//label[@for='list_price']" position="before">
                <field name="is_vat_inclusive_pricing"/>
            </xpath>
            
            <!-- Make Sales Price readonly when VAT-inclusive mode is enabled -->
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="readonly">is_vat_inclusive_pricing</attribute>
            </xpath>
            
            <!-- Add VAT-Inclusive Price field after the list_price div -->
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <label for="vat_inclusive_price" invisible="not is_vat_inclusive_pricing"/>
                <div class="o_row" invisible="not is_vat_inclusive_pricing">
                    <field name="vat_inclusive_price" 
                           widget="monetary" 
                           options="{'currency_field': 'currency_id', 'field_digits': True}"
                           class="oe_inline"/>
                    <span groups="uom.group_uom">
                        per <field name="uom_id" class="oe_inline" style="max-width:136px" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                    </span>
                </div>
                <div class="text-muted small" invisible="not is_vat_inclusive_pricing or vat_rate_display == 0">
                    <span>Base: </span>
                    <field name="computed_base_price" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline" readonly="1"/>
                    <span> + VAT </span>
                    <field name="vat_rate_display" class="oe_inline" readonly="1"/>
                    <span>%: </span>
                    <field name="computed_vat_amount" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline" readonly="1"/>
                </div>
                <div class="text-warning small" invisible="not is_vat_inclusive_pricing or vat_rate_display != 0">
                    <i class="fa fa-exclamation-triangle"/> No VAT tax configured in Sales Taxes
                </div>
            </xpath>
            
            <!-- Hide Sales Price label when VAT-inclusive mode -->
            <xpath expr="//label[@for='list_price']" position="attributes">
                <attribute name="invisible">is_vat_inclusive_pricing</attribute>
            </xpath>
            
            <!-- Hide Sales Price div when VAT-inclusive mode -->
            <xpath expr="//div[@name='list_price_uom']" position="attributes">
                <attribute name="invisible">is_vat_inclusive_pricing</attribute>
            </xpath>
        </field>
    </record>

    <!-- Add BIR Discount Settings to Product Template Form -->
    <!-- Add BIR Discount Settings to Sales Tab -->
    <record id="product_template_form_view_inherit_bir_sales" model="ir.ui.view">
        <field name="name">product.template.form.inherit.bir.sales</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="BIR Discount Settings" name="bir_discount_settings">
                    <field name="is_bir_discountable"/>
                    <field name="bir_discount_exclusion_reason" 
                        invisible="is_bir_discountable"/>
                    <field name="bir_discountable_notes"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add BIR Discount Settings to POS Tab (only if point_of_sale is installed) -->
    <record id="product_template_form_view_inherit_bir_pos" model="ir.ui.view">
        <field name="name">product.template.form.inherit.bir.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']" position="inside">
                <group string="BIR Discount Settings" name="bir_discount_settings_pos">
                    <field name="is_bir_discountable"/>
                    <field name="bir_discount_exclusion_reason" 
                        invisible="is_bir_discountable"/>
                    <field name="bir_discountable_notes"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add BIR Discount column to Product Template List View (Optional) -->
    <record id="product_template_tree_view_inherit_bir" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.bir</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="is_bir_discountable" 
                       string="PWD/SC" 
                       widget="boolean_toggle"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Add BIR Discount Settings to Product Variant Form (if variant-specific) -->
    <record id="product_product_form_view_inherit_bir" model="ir.ui.view">
        <field name="name">product.product.form.inherit.bir</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- Add to General Information tab -->
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="BIR Discount Settings" name="bir_discount_settings">
                    <field name="is_bir_discountable"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add search filter for PWD/SC Discountable products -->
    <record id="product_template_search_view_inherit_bir" model="ir.ui.view">
        <field name="name">product.template.search.inherit.bir</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="PWD/SC Discountable" 
                        name="bir_discountable" 
                        domain="[('is_bir_discountable', '=', True)]"/>
                <filter string="Not PWD/SC Discountable" 
                        name="bir_not_discountable" 
                        domain="[('is_bir_discountable', '=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>

